{
  "name": "@flowzer/react",
  "version": "0.1.0",
  "description": "Host-neutrale React-Controller und Hooks für Flowzer",
  "type": "module",
  "license": "MPL-2.0",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flowzer-io/flowzer-bpmn-core-engine.git",
    "directory": "packages/flowzer-react"
  },
  "homepage": "https://github.com/flowzer-io/flowzer-bpmn-core-engine/tree/main/packages/flowzer-react#readme",
  "bugs": {
    "url": "https://github.com/flowzer-io/flowzer-bpmn-core-engine/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --environment jsdom",
    "check": "npm run typecheck && npm run test && npm run build",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "peerDependencies": {
    "@flowzer/sdk": "^0.1.0",
    "@tanstack/react-query": ">=5 <6",
    "react": ">=18 <20"
  },
  "devDependencies": {
    "@flowzer/sdk": "file:../flowzer-sdk",
    "@tanstack/react-query": "^5.90.12",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "jsdom": "^27.4.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "typescript": "^5.7.3",
    "vitest": "^5.0.0"
  }
}
