{
  "name": "@flowzer/sdk",
  "version": "0.1.0",
  "description": "Host-neutraler TypeScript-Client für die Flowzer Workflow API",
  "type": "module",
  "license": "MPL-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flowzer-io/flowzer-bpmn-core-engine.git",
    "directory": "packages/flowzer-sdk"
  },
  "homepage": "https://github.com/flowzer-io/flowzer-bpmn-core-engine/tree/main/packages/flowzer-sdk#readme",
  "bugs": {
    "url": "https://github.com/flowzer-io/flowzer-bpmn-core-engine/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "generate:openapi": "openapi-typescript ../../docs/openapi.json -o src/schema.generated.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test && npm run build",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "openapi-typescript": "^7.6.1",
    "typescript": "^5.7.3",
    "vitest": "^5.0.0"
  }
}
