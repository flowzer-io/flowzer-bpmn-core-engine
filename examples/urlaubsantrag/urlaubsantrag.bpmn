<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="flowzer-urlaubsantrag" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_Urlaubsantrag" name="Urlaubsantrag" isExecutable="true">

    <!-- Der Antrag wird beim Start ausgefuellt: Das Formular am reinen Startereignis
         liefert die Startvariablen des Vorgangs. -->
    <bpmn:startEvent id="Start_Antrag" name="Urlaubsantrag stellen">
      <bpmn:extensionElements>
        <zeebe:formDefinition formKey="Urlaubsantrag" />
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_Start_Fork</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:parallelGateway id="Gw_Fork_Pruefung" name="Prüfungen">
      <bpmn:incoming>Flow_Start_Fork</bpmn:incoming>
      <bpmn:outgoing>Flow_Fork_Tage</bpmn:outgoing>
      <bpmn:outgoing>Flow_Fork_Fachlich</bpmn:outgoing>
      <bpmn:outgoing>Flow_Fork_Vertretung</bpmn:outgoing>
    </bpmn:parallelGateway>

    <bpmn:userTask id="Task_Urlaubstage" name="Urlaubstage prüfen">
      <bpmn:extensionElements>
        <zeebe:formDefinition formKey="Prüfung" />
        <zeebe:assignmentDefinition candidateGroups="Lohnbuchhaltung" />
        <zeebe:taskSchedule dueDate="PT48H" />
        <!-- Das Formular ist allgemein; die Zuordnung zu diesem Vorgang steht hier.
             Eingang: was im Formular zu sehen ist. Ausgang: unter welchen Namen die
             Antworten in den Prozess zurueckgehen. -->
        <zeebe:ioMapping>
          <zeebe:input source="=vorgang" target="vorgang" />
          <zeebe:output source="=pruefungBestanden" target="tageAusreichend" />
          <zeebe:output source="=pruefwert" target="resttage" />
          <zeebe:output source="=pruefkommentar" target="lohnbuchhaltungKommentar" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Fork_Tage</bpmn:incoming>
      <bpmn:outgoing>Flow_Urlaubstage_Tor</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_Fachlich" name="Urlaub fachlich entscheiden">
      <bpmn:extensionElements>
        <zeebe:formDefinition formKey="Freigabe" />
        <zeebe:assignmentDefinition candidateGroups="Vorgesetzte" />
        <zeebe:taskSchedule dueDate="PT48H" />
        <zeebe:ioMapping>
          <zeebe:input source="=vorgang" target="vorgang" />
          <zeebe:output source="=entscheidung" target="fachlicheEntscheidung" />
          <zeebe:output source="=begruendung" target="fachlicheBegruendung" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Fork_Fachlich</bpmn:incoming>
      <bpmn:outgoing>Flow_Fachlich_Tor</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Ein Nachschlagen in vorhandenen Daten, keine Entscheidung: deshalb ein
         Service-Task. Der Worker antwortet mit vertretungFrei = "ja" oder "nein". -->
    <bpmn:serviceTask id="Task_Vertretung" name="Vertretung prüfen">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="urlaub-vertretung-pruefen" />
        <!-- Ohne diese Liste bekaeme der Worker alle Prozessvariablen, auch die Bemerkung
             aus dem Antrag und die interne Benutzerkennung. Ein fremder Dienst bekommt,
             was er braucht. -->
        <zeebe:ioMapping>
          <zeebe:input source="=vertretung" target="vertretung" />
          <zeebe:input source="=von" target="von" />
          <zeebe:input source="=bis" target="bis" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Fork_Vertretung</bpmn:incoming>
      <bpmn:outgoing>Flow_Vertretung_Tor</bpmn:outgoing>
    </bpmn:serviceTask>

    <!--
      Jede Pruefung entscheidet in ihrem eigenen Zweig, direkt hinter der Aufgabe.
      Sagt eine „nein", laeuft sie sofort zur Ablehnung; die beiden anderen Zweige
      werden vom abbrechenden Ende beendet, ihre offenen Aufgaben verschwinden.

      Drei einzelne Tore statt einer zusammengesetzten Bedingung: Die Engine wertet
      Bedingungen in dieser Umgebung mit dem einfachen Ausdrucks-Handler aus, der nur
      einen Vergleich je Ausdruck kennt — ein "und" gäbe es dort nicht. Nebeneffekt:
      Der Ablehnungsgrund ist am Diagramm ablesbar.
    -->
    <bpmn:exclusiveGateway id="Gw_Tage" name="Genug Urlaubstage?" default="Flow_Tage_Nein">
      <bpmn:incoming>Flow_Urlaubstage_Tor</bpmn:incoming>
      <bpmn:outgoing>Flow_Tage_Ja</bpmn:outgoing>
      <bpmn:outgoing>Flow_Tage_Nein</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:exclusiveGateway id="Gw_Fachlich" name="Fachlich genehmigt?" default="Flow_Fachlich_Nein">
      <bpmn:incoming>Flow_Fachlich_Tor</bpmn:incoming>
      <bpmn:outgoing>Flow_Fachlich_Ja</bpmn:outgoing>
      <bpmn:outgoing>Flow_Fachlich_Nein</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:exclusiveGateway id="Gw_Vertretung" name="Vertretung frei?" default="Flow_Vertretung_Nein">
      <bpmn:incoming>Flow_Vertretung_Tor</bpmn:incoming>
      <bpmn:outgoing>Flow_Vertretung_Ja</bpmn:outgoing>
      <bpmn:outgoing>Flow_Vertretung_Nein</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Nur wenn alle drei Tore „ja" gesagt haben, kommen hier drei Tokens an. -->
    <bpmn:parallelGateway id="Gw_Join_Pruefung" name="alle geprüft">
      <bpmn:incoming>Flow_Tage_Ja</bpmn:incoming>
      <bpmn:incoming>Flow_Fachlich_Ja</bpmn:incoming>
      <bpmn:incoming>Flow_Vertretung_Ja</bpmn:incoming>
      <bpmn:outgoing>Flow_Join_Fork</bpmn:outgoing>
    </bpmn:parallelGateway>

    <bpmn:parallelGateway id="Gw_Fork_Genehmigt" name="genehmigt">
      <bpmn:incoming>Flow_Join_Fork</bpmn:incoming>
      <bpmn:outgoing>Flow_Genehmigt_Nachricht</bpmn:outgoing>
      <bpmn:outgoing>Flow_Genehmigt_LexOffice</bpmn:outgoing>
      <bpmn:outgoing>Flow_Genehmigt_Fachsystem</bpmn:outgoing>
    </bpmn:parallelGateway>

    <bpmn:serviceTask id="Task_Nachricht" name="Antragsteller benachrichtigen">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="urlaub-genehmigung-mitteilen" />
        <zeebe:ioMapping>
          <zeebe:input source="=mitarbeiter" target="mitarbeiter" />
          <zeebe:input source="=vorgang" target="vorgang" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Genehmigt_Nachricht</bpmn:incoming>
      <bpmn:outgoing>Flow_Nachricht_Join</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:userTask id="Task_LexOffice" name="Urlaub in LexOffice eintragen">
      <bpmn:extensionElements>
        <zeebe:formDefinition formKey="Erledigung bestätigen" />
        <zeebe:assignmentDefinition candidateGroups="Lohnbuchhaltung" />
        <zeebe:taskSchedule dueDate="P3D" />
        <zeebe:ioMapping>
          <zeebe:input source="=vorgang" target="vorgang" />
          <zeebe:output source="=erledigt" target="lexofficeEingetragen" />
          <zeebe:output source="=referenz" target="lexofficeReferenz" />
          <zeebe:output source="=anmerkung" target="lexofficeAnmerkung" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Genehmigt_LexOffice</bpmn:incoming>
      <bpmn:outgoing>Flow_LexOffice_Join</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:serviceTask id="Task_Fachsystem" name="Urlaub in externem Fachsystem eintragen">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="urlaub-fachsystem-eintragen" />
        <zeebe:ioMapping>
          <zeebe:input source="=mitarbeiter" target="mitarbeiter" />
          <zeebe:input source="=von" target="von" />
          <zeebe:input source="=bis" target="bis" />
          <zeebe:input source="=arbeitstage" target="arbeitstage" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Genehmigt_Fachsystem</bpmn:incoming>
      <bpmn:outgoing>Flow_Fachsystem_Join</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:parallelGateway id="Gw_Join_Genehmigt" name="alles erledigt">
      <bpmn:incoming>Flow_Nachricht_Join</bpmn:incoming>
      <bpmn:incoming>Flow_LexOffice_Join</bpmn:incoming>
      <bpmn:incoming>Flow_Fachsystem_Join</bpmn:incoming>
      <bpmn:outgoing>Flow_Join_Ende</bpmn:outgoing>
    </bpmn:parallelGateway>

    <bpmn:endEvent id="End_Genehmigt" name="Urlaub genehmigt">
      <bpmn:incoming>Flow_Join_Ende</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:serviceTask id="Task_Ablehnung" name="Ablehnung mitteilen">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="urlaub-ablehnung-mitteilen" />
        <!-- Hier liegt ein Schnappschuss der Entscheidungen, die bis zu diesem Moment
             gefallen sind: mindestens die, die „nein" gesagt hat — andere koennen schon
             fertig sein („ja" oder, im seltenen Fall, ein zweites „nein"), die uebrigen
             laufen noch, ihre Variablen gibt es also noch nicht. Die Liste bleibt trotzdem
             stehen: Ein fehlender Eingang ist kein Fehler, er kommt leer an. Der Worker
             sucht sich die Pruefung heraus, die „nein" gesagt hat, und nennt ihren Grund.
             Ohne diese Liste bekaeme ein fremder Dienst alle Prozessvariablen, auch die
             Bemerkung aus dem Antrag. -->
        <zeebe:ioMapping>
          <zeebe:input source="=mitarbeiter" target="mitarbeiter" />
          <zeebe:input source="=vorgang" target="vorgang" />
          <zeebe:input source="=tageAusreichend" target="tageAusreichend" />
          <zeebe:input source="=fachlicheEntscheidung" target="fachlicheEntscheidung" />
          <zeebe:input source="=vertretungFrei" target="vertretungFrei" />
          <zeebe:input source="=fachlicheBegruendung" target="fachlicheBegruendung" />
          <zeebe:input source="=lohnbuchhaltungKommentar" target="lohnbuchhaltungKommentar" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Tage_Nein</bpmn:incoming>
      <bpmn:incoming>Flow_Fachlich_Nein</bpmn:incoming>
      <bpmn:incoming>Flow_Vertretung_Nein</bpmn:incoming>
      <bpmn:outgoing>Flow_Ablehnung_Ende</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Ein abbrechendes Ende: Es beendet nicht nur seinen eigenen Zweig, sondern den
         ganzen Vorgang. Die beiden Pruefungen, die noch laufen, hoeren damit auf, und
         ihre offenen Aufgaben verschwinden aus den Aufgabenlisten — niemand arbeitet
         noch an einem Antrag, der schon abgelehnt ist. -->
    <bpmn:endEvent id="End_Abgelehnt" name="Antrag abgelehnt">
      <bpmn:incoming>Flow_Ablehnung_Ende</bpmn:incoming>
      <bpmn:terminateEventDefinition id="Terminate_Abgelehnt" />
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_Start_Fork" sourceRef="Start_Antrag" targetRef="Gw_Fork_Pruefung" />
    <bpmn:sequenceFlow id="Flow_Fork_Tage" sourceRef="Gw_Fork_Pruefung" targetRef="Task_Urlaubstage" />
    <bpmn:sequenceFlow id="Flow_Fork_Fachlich" sourceRef="Gw_Fork_Pruefung" targetRef="Task_Fachlich" />
    <bpmn:sequenceFlow id="Flow_Fork_Vertretung" sourceRef="Gw_Fork_Pruefung" targetRef="Task_Vertretung" />

    <bpmn:sequenceFlow id="Flow_Urlaubstage_Tor" sourceRef="Task_Urlaubstage" targetRef="Gw_Tage" />
    <bpmn:sequenceFlow id="Flow_Fachlich_Tor" sourceRef="Task_Fachlich" targetRef="Gw_Fachlich" />
    <bpmn:sequenceFlow id="Flow_Vertretung_Tor" sourceRef="Task_Vertretung" targetRef="Gw_Vertretung" />

    <bpmn:sequenceFlow id="Flow_Tage_Ja" name="ja" sourceRef="Gw_Tage" targetRef="Gw_Join_Pruefung">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=tageAusreichend = "ja"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Tage_Nein" name="nicht genug Tage" sourceRef="Gw_Tage" targetRef="Task_Ablehnung" />

    <bpmn:sequenceFlow id="Flow_Fachlich_Ja" name="ja" sourceRef="Gw_Fachlich" targetRef="Gw_Join_Pruefung">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=fachlicheEntscheidung = "freigegeben"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Fachlich_Nein" name="abgelehnt" sourceRef="Gw_Fachlich" targetRef="Task_Ablehnung" />

    <bpmn:sequenceFlow id="Flow_Vertretung_Ja" name="ja" sourceRef="Gw_Vertretung" targetRef="Gw_Join_Pruefung">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=vertretungFrei = "ja"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Vertretung_Nein" name="Vertretung im Urlaub" sourceRef="Gw_Vertretung" targetRef="Task_Ablehnung" />

    <bpmn:sequenceFlow id="Flow_Join_Fork" sourceRef="Gw_Join_Pruefung" targetRef="Gw_Fork_Genehmigt" />

    <bpmn:sequenceFlow id="Flow_Genehmigt_Nachricht" sourceRef="Gw_Fork_Genehmigt" targetRef="Task_Nachricht" />
    <bpmn:sequenceFlow id="Flow_Genehmigt_LexOffice" sourceRef="Gw_Fork_Genehmigt" targetRef="Task_LexOffice" />
    <bpmn:sequenceFlow id="Flow_Genehmigt_Fachsystem" sourceRef="Gw_Fork_Genehmigt" targetRef="Task_Fachsystem" />
    <bpmn:sequenceFlow id="Flow_Nachricht_Join" sourceRef="Task_Nachricht" targetRef="Gw_Join_Genehmigt" />
    <bpmn:sequenceFlow id="Flow_LexOffice_Join" sourceRef="Task_LexOffice" targetRef="Gw_Join_Genehmigt" />
    <bpmn:sequenceFlow id="Flow_Fachsystem_Join" sourceRef="Task_Fachsystem" targetRef="Gw_Join_Genehmigt" />
    <bpmn:sequenceFlow id="Flow_Join_Ende" sourceRef="Gw_Join_Genehmigt" targetRef="End_Genehmigt" />
    <bpmn:sequenceFlow id="Flow_Ablehnung_Ende" sourceRef="Task_Ablehnung" targetRef="End_Abgelehnt" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_Urlaubsantrag">
    <bpmndi:BPMNPlane id="BPMNPlane_Urlaubsantrag" bpmnElement="Process_Urlaubsantrag">

      <bpmndi:BPMNShape id="Shape_Start_Antrag" bpmnElement="Start_Antrag">
        <dc:Bounds x="330" y="302" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="293" y="345" width="110" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Gw_Fork_Pruefung" bpmnElement="Gw_Fork_Pruefung">
        <dc:Bounds x="420" y="295" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="416" y="265" width="58" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Task_Urlaubstage" bpmnElement="Task_Urlaubstage">
        <dc:Bounds x="520" y="140" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Fachlich" bpmnElement="Task_Fachlich">
        <dc:Bounds x="520" y="280" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Vertretung" bpmnElement="Task_Vertretung">
        <dc:Bounds x="520" y="420" width="140" height="80" />
      </bpmndi:BPMNShape>

      <!-- Jedes Tor steht in seinem Zweig, direkt hinter der zugehoerigen Aufgabe. -->
      <bpmndi:BPMNShape id="Shape_Gw_Tage" bpmnElement="Gw_Tage" isMarkerVisible="true">
        <dc:Bounds x="700" y="155" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="683" y="115" width="85" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Gw_Fachlich" bpmnElement="Gw_Fachlich" isMarkerVisible="true">
        <dc:Bounds x="760" y="295" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="743" y="255" width="85" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Gw_Vertretung" bpmnElement="Gw_Vertretung" isMarkerVisible="true">
        <dc:Bounds x="820" y="435" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="806" y="395" width="79" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Gw_Join_Pruefung" bpmnElement="Gw_Join_Pruefung">
        <dc:Bounds x="920" y="295" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="910" y="265" width="71" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Gw_Fork_Genehmigt" bpmnElement="Gw_Fork_Genehmigt">
        <dc:Bounds x="1010" y="295" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="1005" y="265" width="61" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Task_Nachricht" bpmnElement="Task_Nachricht">
        <dc:Bounds x="1110" y="140" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_LexOffice" bpmnElement="Task_LexOffice">
        <dc:Bounds x="1110" y="280" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Fachsystem" bpmnElement="Task_Fachsystem">
        <dc:Bounds x="1110" y="420" width="140" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Gw_Join_Genehmigt" bpmnElement="Gw_Join_Genehmigt">
        <dc:Bounds x="1310" y="295" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="1297" y="265" width="77" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_Genehmigt" bpmnElement="End_Genehmigt">
        <dc:Bounds x="1400" y="302" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="1376" y="345" width="85" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- Der Ablehnungspfad liegt unter allen drei Zweigen: Jedes „nein" faellt aus
           seinem Zweig nach unten heraus. -->
      <bpmndi:BPMNShape id="Shape_Task_Ablehnung" bpmnElement="Task_Ablehnung">
        <dc:Bounds x="940" y="580" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_Abgelehnt" bpmnElement="End_Abgelehnt">
        <dc:Bounds x="1160" y="602" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="1136" y="645" width="85" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="Edge_Flow_Start_Fork" bpmnElement="Flow_Start_Fork">
        <di:waypoint x="366" y="320" /><di:waypoint x="420" y="320" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Fork_Tage" bpmnElement="Flow_Fork_Tage">
        <di:waypoint x="445" y="295" /><di:waypoint x="445" y="180" /><di:waypoint x="520" y="180" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Fork_Fachlich" bpmnElement="Flow_Fork_Fachlich">
        <di:waypoint x="470" y="320" /><di:waypoint x="520" y="320" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Fork_Vertretung" bpmnElement="Flow_Fork_Vertretung">
        <di:waypoint x="445" y="345" /><di:waypoint x="445" y="460" /><di:waypoint x="520" y="460" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Edge_Flow_Urlaubstage_Tor" bpmnElement="Flow_Urlaubstage_Tor">
        <di:waypoint x="660" y="180" /><di:waypoint x="700" y="180" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Fachlich_Tor" bpmnElement="Flow_Fachlich_Tor">
        <di:waypoint x="660" y="320" /><di:waypoint x="760" y="320" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Vertretung_Tor" bpmnElement="Flow_Vertretung_Tor">
        <di:waypoint x="660" y="460" /><di:waypoint x="820" y="460" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Edge_Flow_Tage_Ja" bpmnElement="Flow_Tage_Ja">
        <di:waypoint x="750" y="180" /><di:waypoint x="945" y="180" /><di:waypoint x="945" y="295" />
        <bpmndi:BPMNLabel><dc:Bounds x="760" y="162" width="14" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Fachlich_Ja" bpmnElement="Flow_Fachlich_Ja">
        <di:waypoint x="810" y="320" /><di:waypoint x="920" y="320" />
        <bpmndi:BPMNLabel><dc:Bounds x="845" y="302" width="14" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Vertretung_Ja" bpmnElement="Flow_Vertretung_Ja">
