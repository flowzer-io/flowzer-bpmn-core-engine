{
  "display": "form",
  "components": [
    {
      "type": "textfield",
      "key": "mitarbeiter",
      "label": "Name",
      "input": true,
      "description": "Für wen wird der Urlaub beantragt?",
      "validate": {
        "required": true
      }
    },
    {
      "type": "select",
      "key": "art",
      "label": "Art des Urlaubs",
      "input": true,
      "defaultValue": "erholung",
      "data": {
        "values": [
          {
            "label": "Erholungsurlaub",
            "value": "erholung"
          },
          {
            "label": "Sonderurlaub",
            "value": "sonder"
          },
          {
            "label": "Unbezahlter Urlaub",
            "value": "unbezahlt"
          }
        ]
      },
      "validate": {
        "required": true
      }
    },
    {
      "type": "columns",
      "key": "zeitraum",
      "label": "Zeitraum",
      "input": false,
      "columns": [
        {
          "width": 6,
          "components": [
            {
              "type": "datetime",
              "key": "von",
              "label": "Erster Urlaubstag",
              "input": true,
              "enableTime": false,
              "format": "dd.MM.yyyy",
              "validate": {
                "required": true
              },
              "allowInput": true,
              "placeholder": "TT.MM.JJJJ"
            }
          ]
        },
        {
          "width": 6,
          "components": [
            {
              "type": "datetime",
              "key": "bis",
              "label": "Letzter Urlaubstag",
              "input": true,
              "enableTime": false,
              "format": "dd.MM.yyyy",
              "validate": {
                "required": true
              },
              "allowInput": true,
              "placeholder": "TT.MM.JJJJ"
            }
          ]
        }
      ]
    },
    {
      "type": "number",
      "key": "arbeitstage",
      "label": "Beantragte Arbeitstage",
      "input": true,
      "description": "Ohne Wochenenden und Feiertage.",
      "validate": {
        "required": true,
        "min": 1
      }
    },
    {
      "type": "textfield",
      "key": "vertretung",
      "label": "Vertretung",
      "input": true,
      "description": "Wer übernimmt in dieser Zeit? Die externe Prüfung ist ein optional anzubindender Beispiel-Konnektor.",
      "validate": {
        "required": true
      }
    },
    {
      "type": "textarea",
      "key": "bemerkung",
      "label": "Bemerkung",
      "input": true,
      "rows": 3
    },
    {
      "type": "hidden",
      "key": "vorgang",
      "label": "",
      "input": true,
      "hideLabel": true,
      "tableView": false,
      "clearOnHide": false,
      "flowzer": {
        "calculation": {
          "name": "join.v1",
          "fields": [
            "mitarbeiter",
            "art",
            "von",
            "bis",
            "arbeitstage",
            "vertretung"
          ]
        }
      }
    }
  ],
  "flowzer": {
    "contractVersion": 1,
    "rules": [
      {
        "kind": "dateOrder",
        "start": "von",
        "end": "bis",
        "allowEqual": true
      }
    ]
  }
}
