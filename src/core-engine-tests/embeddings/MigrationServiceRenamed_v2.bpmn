<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="Definitions_MigrationServiceRenamed_v2" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_MigrationService" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="ServiceTask_FetchRenamed" name="Fetch">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="fetch" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ServiceTask_Enrich" name="Enrich">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="enrich" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_1">
      <bpmn:incoming>Flow_3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="ServiceTask_FetchRenamed" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="ServiceTask_FetchRenamed" targetRef="ServiceTask_Enrich" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="ServiceTask_Enrich" targetRef="EndEvent_1" />
  </bpmn:process>
</bpmn:definitions>
