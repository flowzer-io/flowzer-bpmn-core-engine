<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_EscalationBoundaryNonInterrupting" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:escalation id="Escalation_Nachfrage" name="Nachfrage noetig" escalationCode="NACHFRAGE" />
  <bpmn:process id="Process_EscalationBoundaryNonInterrupting" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1"><bpmn:outgoing>Flow_ToSub</bpmn:outgoing></bpmn:startEvent>
    <bpmn:subProcess id="SubProcess_1">
      <bpmn:incoming>Flow_ToSub</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEnd</bpmn:outgoing>
      <bpmn:startEvent id="SubStart_1"><bpmn:outgoing>SubFlow_ToThrow</bpmn:outgoing></bpmn:startEvent>
      <bpmn:intermediateThrowEvent id="Throw_Escalation">
        <bpmn:incoming>SubFlow_ToThrow</bpmn:incoming>
        <bpmn:outgoing>SubFlow_ToInner</bpmn:outgoing>
        <bpmn:escalationEventDefinition id="ESD_Throw" escalationRef="Escalation_Nachfrage" />
      </bpmn:intermediateThrowEvent>
      <bpmn:serviceTask id="ServiceTask_Inner" name="ServiceTask_Inner">
        <bpmn:extensionElements><zeebe:taskDefinition type="inner" /></bpmn:extensionElements>
        <bpmn:incoming>SubFlow_ToInner</bpmn:incoming>
        <bpmn:outgoing>SubFlow_ToEnd</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="SubEnd_1"><bpmn:incoming>SubFlow_ToEnd</bpmn:incoming></bpmn:endEvent>
      <bpmn:sequenceFlow id="SubFlow_ToThrow" sourceRef="SubStart_1" targetRef="Throw_Escalation" />
      <bpmn:sequenceFlow id="SubFlow_ToInner" sourceRef="Throw_Escalation" targetRef="ServiceTask_Inner" />
      <bpmn:sequenceFlow id="SubFlow_ToEnd" sourceRef="ServiceTask_Inner" targetRef="SubEnd_1" />
    </bpmn:subProcess>
    <bpmn:boundaryEvent id="Boundary_Escalation" attachedToRef="SubProcess_1" cancelActivity="false">
      <bpmn:outgoing>Flow_ToNotify</bpmn:outgoing>
      <bpmn:escalationEventDefinition id="ESD_Boundary" escalationRef="Escalation_Nachfrage" />
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="ServiceTask_Notify" name="ServiceTask_Notify">
      <bpmn:extensionElements><zeebe:taskDefinition type="notify" /></bpmn:extensionElements>
      <bpmn:incoming>Flow_ToNotify</bpmn:incoming>
      <bpmn:outgoing>Flow_ToNotifyEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_Regular"><bpmn:incoming>Flow_ToEnd</bpmn:incoming></bpmn:endEvent>
    <bpmn:endEvent id="EndEvent_Notified"><bpmn:incoming>Flow_ToNotifyEnd</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_ToSub" sourceRef="StartEvent_1" targetRef="SubProcess_1" />
    <bpmn:sequenceFlow id="Flow_ToEnd" sourceRef="SubProcess_1" targetRef="EndEvent_Regular" />
    <bpmn:sequenceFlow id="Flow_ToNotify" sourceRef="Boundary_Escalation" targetRef="ServiceTask_Notify" />
    <bpmn:sequenceFlow id="Flow_ToNotifyEnd" sourceRef="ServiceTask_Notify" targetRef="EndEvent_Notified" />
  </bpmn:process>
</bpmn:definitions>
