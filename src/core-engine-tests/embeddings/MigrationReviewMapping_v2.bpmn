<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="Definitions_MigrationReviewMapping_v2" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_MigrationReview" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="Gateway_Decide" name="Decide">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="UserTask_ReviewNew" name="Review">
      <bpmn:extensionElements>
        <zeebe:formDefinition formKey="review-form-v2" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask_Approve" name="Approve">
      <bpmn:extensionElements>
        <zeebe:formDefinition formKey="approve-form" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="EndEvent_1">
      <bpmn:incoming>Flow_4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Gateway_Decide" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Gateway_Decide" targetRef="UserTask_ReviewNew" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="UserTask_ReviewNew" targetRef="UserTask_Approve" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="UserTask_Approve" targetRef="EndEvent_1" />
  </bpmn:process>
</bpmn:definitions>
