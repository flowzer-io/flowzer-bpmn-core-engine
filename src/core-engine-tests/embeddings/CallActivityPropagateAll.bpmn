<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="Definitions_CallActivityPropagateAll" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_CallActivityPropagateAll" isExecutable="true">
