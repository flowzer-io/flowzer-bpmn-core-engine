<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="Definitions_ErrorBoundaryOnServiceTask" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:error id="Error_Fachlich" name="Bonitaet nicht ausreichend" errorCode="BONITAET" />
  <bpmn:message id="Message_Abbruch" name="Abbruch" />
  <bpmn:process id="Process_ErrorBoundaryOnServiceTask" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1">
      <bpmn:outgoing>Flow_Start</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="ServiceTask_1" name="Bonitaet pruefen">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="bonitaet" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Start</bpmn:incoming>
      <bpmn:outgoing>Flow_Regular</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="BoundaryError_1" name="Fehler" attachedToRef="ServiceTask_1">
      <bpmn:outgoing>Flow_Boundary</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorEventDefinition_1" errorRef="Error_Fachlich" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="BoundaryMessage_1" name="Abbruch" attachedToRef="ServiceTask_1">
      <bpmn:outgoing>Flow_Cancelled</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_1" messageRef="Message_Abbruch" />
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="ServiceTask_Recover" name="Nacharbeit">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="recover" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Boundary</bpmn:incoming>
      <bpmn:outgoing>Flow_Recovered</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_Recovered">
      <bpmn:incoming>Flow_Recovered</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="EndEvent_Cancelled">
      <bpmn:incoming>Flow_Cancelled</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="EndEvent_Regular">
      <bpmn:incoming>Flow_Regular</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Start" sourceRef="StartEvent_1" targetRef="ServiceTask_1" />
    <bpmn:sequenceFlow id="Flow_Regular" sourceRef="ServiceTask_1" targetRef="EndEvent_Regular" />
    <bpmn:sequenceFlow id="Flow_Boundary" sourceRef="BoundaryError_1" targetRef="ServiceTask_Recover" />
    <bpmn:sequenceFlow id="Flow_Recovered" sourceRef="ServiceTask_Recover" targetRef="EndEvent_Recovered" />
    <bpmn:sequenceFlow id="Flow_Cancelled" sourceRef="BoundaryMessage_1" targetRef="EndEvent_Cancelled" />
  </bpmn:process>
</bpmn:definitions>
