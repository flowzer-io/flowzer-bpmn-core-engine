<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="Definitions_MessageEnd" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:message id="Message_Abschluss" name="Vorgang abgeschlossen">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=antragsnummer" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:process id="Process_MessageEnd" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1">
      <bpmn:outgoing>Flow_Start</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="MessageEnd_1" name="Abschluss melden">
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:input source="=antragsnummer" target="antragsnummer" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Start</bpmn:incoming>
      <bpmn:messageEventDefinition id="MessageEventDefinition_1" messageRef="Message_Abschluss" />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Start" sourceRef="StartEvent_1" targetRef="MessageEnd_1" />
  </bpmn:process>
</bpmn:definitions>
