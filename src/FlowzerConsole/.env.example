# Basis-URL der Flowzer Web-API.
#
# Leer lassen (oder auf "/api" setzen), um im Dev-Betrieb den Vite-Proxy zu nutzen.
# Der Proxy zeigt auf FLOWZER_API_URL (Standard: http://localhost:5182).
VITE_FLOWZER_API_URL=/api

# Ziel des Dev-Proxys — nur zur Entwicklungszeit relevant.
# 5182 ist der Port aus src/WebApiEngine/Properties/launchSettings.json.
FLOWZER_API_URL=http://localhost:5182

# Akzentfarbe der Oberflaeche: iris, teal, emerald, amber oder rose.
# Im Container kommt sie aus FLOWZER_ACCENT; hier steht das Gegenstueck fuer den
# Entwicklungsbetrieb, in dem es keine config.json gibt.
VITE_FLOWZER_ACCENT=iris
