{
  "name": "flowzer-console",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Flowzer Console — React/TypeScript UI für die Flowzer BPMN Engine (API-first)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "api:types": "openapi-typescript http://localhost:5000/swagger/v1/swagger.json -o src/lib/api/schema.gen.ts",
    "icons": "node scripts/generate-icons.mjs",
    "seed": "node scripts/seed-demo.mjs"
  },
  "dependencies": {
    "@bpmn-io/properties-panel": "^3.26.4",
    "@fontsource-variable/bricolage-grotesque": "^5.2.5",
    "@fontsource-variable/hanken-grotesk": "^5.2.5",
    "@fontsource-variable/jetbrains-mono": "^5.2.5",
    "@formio/js": "^5.1.1",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-popover": "^1.1.6",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-tooltip": "^1.1.8",
    "@tanstack/react-query": "^5.66.0",
    "@tanstack/react-router": "^1.105.0",
    "bpmn-js": "^18.6.2",
    "bpmn-js-properties-panel": "^5.35.0",
    "camunda-bpmn-js-behaviors": "^1.9.0",
    "clsx": "^2.1.1",
    "cmdk": "^1.0.4",
    "date-fns": "^4.1.0",
    "oidc-client-ts": "^3.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sonner": "^2.0.1",
    "tailwind-merge": "^3.0.2",
    "zeebe-bpmn-moddle": "^1.9.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@material-symbols/svg-400": "^0.36.0",
    "@tailwindcss/vite": "^4.0.9",
    "@tanstack/react-query-devtools": "^5.66.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.1",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.21.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "jsdom": "^26.0.0",
    "openapi-typescript": "^7.6.1",
    "tailwindcss": "^4.0.9",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.25.0",
    "vite": "^6.2.0",
    "vitest": "^3.0.7"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
