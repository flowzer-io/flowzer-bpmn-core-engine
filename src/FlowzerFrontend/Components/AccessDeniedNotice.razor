@using FlowzerFrontend.Auth
@implements IDisposable
@inject ApiAccessState AccessState

@if (AccessState.IsAccessDenied)
{
    <div class="access-denied" role="alert">
        <i class="fa-solid fa-lock access-denied-icon" aria-hidden="true"></i>
        <div>
            <h2 class="access-denied-title">Kein Zugang zu Flowzer</h2>
            <p class="access-denied-text">
                Die Anmeldung hat funktioniert, aber dieses Konto ist für Flowzer nicht freigeschaltet.
                Wenden Sie sich an die IT und bitten Sie um die Freigabe für Flowzer.
            </p>
        </div>
    </div>
}

@code {

    protected override void OnInitialized()
    {
        AccessState.Changed += OnAccessStateChanged;
    }

    private void OnAccessStateChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        AccessState.Changed -= OnAccessStateChanged;
    }

}
