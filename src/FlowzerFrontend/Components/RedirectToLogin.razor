@inject NavigationManager NavigationManager
@inject FlowzerOidcOptions OidcOptions

@code {
    // Nicht angemeldete Aufrufe werden zum Identity Provider geleitet und kehren danach zur
    // urspruenglichen Seite zurueck. Ohne OIDC gilt die Oberflaeche immer als angemeldet.
    protected override void OnInitialized()
    {
        if (OidcOptions.IsEnabled)
        {
            NavigationManager.NavigateToLogin(FlowzerOidcOptions.LoginPath);
        }
    }
}
