@inject NavigationManager NavigationManager
@inject FlowzerOidcOptions OidcOptions

<div class="app-user-menu" id="app-user-menu">
    <AuthorizeView>
        <Authorized>
            <span class="app-user-name" title="@context.User.Identity?.Name">
                <i class="fa-regular fa-user" aria-hidden="true"></i>
                @(context.User.Identity?.Name ?? "Signed in")
            </span>
            @if (OidcOptions.IsEnabled)
            {
                <button type="button" class="app-user-logout" @onclick="SignOut">Sign out</button>
            }
        </Authorized>
        <NotAuthorized>
            <a class="app-user-logout" href="@FlowzerOidcOptions.LoginPath">Sign in</a>
        </NotAuthorized>
    </AuthorizeView>
</div>

@code {
    private void SignOut()
    {
        NavigationManager.NavigateToLogout(FlowzerOidcOptions.LogoutPath);
    }
}
