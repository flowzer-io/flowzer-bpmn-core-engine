<?xml version="1.0" encoding="UTF-8"?>
<!-- Alter DMN-1.1-Namensraum mit Praefix. Der Parser arbeitet ueber die lokalen
     Elementnamen und liest die Datei genauso wie eine aus 1.3. -->
<dmn:definitions xmlns:dmn="http://www.omg.org/spec/DMN/20151101/dmn.xsd"
                 id="legacyDefinitions"
                 name="Altes Modell"
                 namespace="http://flowzer.maass.it/dmn/legacy">
  <dmn:decision id="legacyDecision" name="Bonus">
    <dmn:variable name="bonus" typeRef="number"/>
    <dmn:decisionTable id="legacyTable" hitPolicy="UNIQUE">
      <dmn:input id="legacyInputYears">
        <dmn:inputExpression id="legacyInputYearsExpression" typeRef="number">
          <dmn:text>years</dmn:text>
        </dmn:inputExpression>
      </dmn:input>
      <dmn:output id="legacyOutput" name="bonus" typeRef="number"/>
      <dmn:rule id="legacyRuleShort">
        <dmn:inputEntry id="legacyRuleShortYears"><dmn:text>&lt; 5</dmn:text></dmn:inputEntry>
        <dmn:outputEntry id="legacyRuleShortOut"><dmn:text>100</dmn:text></dmn:outputEntry>
      </dmn:rule>
      <dmn:rule id="legacyRuleLong">
        <dmn:inputEntry id="legacyRuleLongYears"><dmn:text>&gt;= 5</dmn:text></dmn:inputEntry>
        <dmn:outputEntry id="legacyRuleLongOut"><dmn:text>500</dmn:text></dmn:outputEntry>
      </dmn:rule>
    </dmn:decisionTable>
  </dmn:decision>
</dmn:definitions>
