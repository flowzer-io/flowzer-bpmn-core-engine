<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="coverlet.collector" Version="8.0.1" />
        <PackageReference Include="FluentAssertions" Version="8.9.0" />
        <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.6" />
        <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="9.10.0" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.4.0" />
        <PackageReference Include="NUnit" Version="4.5.1" />
        <PackageReference Include="NUnit.Analyzers" Version="4.12.0" />
        <PackageReference Include="NUnit3TestAdapter" Version="6.2.0" />
        <PackageReference Include="Testcontainers.PostgreSql" Version="4.14.0" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="NUnit.Framework" />
    </ItemGroup>

    <ItemGroup>
        <!-- Das Beispiel „Urlaubsantrag" wird im Original durchgespielt, damit der Abbruch bei
             einer abgelehnten Pruefung nicht nur an einem Testmodell haengt. Die Formulare
             kommen mit: Ihre Namen sind die Form-Keys im Modell. -->
        <None Include="..\..\examples\urlaubsantrag\urlaubsantrag.bpmn"
              Link="examples\urlaubsantrag.bpmn">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
        <None Include="..\..\examples\urlaubsantrag\formulare\urlaubsantrag.json"
              Link="examples\formulare\urlaubsantrag.json">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
        <None Include="..\..\examples\formulare-generisch\*.json"
              Link="examples\formulare\%(Filename)%(Extension)">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
        <!-- Gemeinsamer, versionierter Vertrag: dieselben Dateien liest auch Vitest. -->
        <None Include="..\..\tests\form-contract-vectors\*.json"
              Link="FormContractVectors\%(Filename)%(Extension)">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\FilesystemStorageSystem\FilesystemStorageSystem.csproj" />
        <ProjectReference Include="..\WebApiEngine\WebApiEngine.csproj" />
        <ProjectReference Include="..\PostgreSqlStorageSystem\PostgreSqlStorageSystem.csproj" />
    </ItemGroup>

</Project>
