{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "TimerScheduler": {
    "Enabled": true,
    "PollIntervalSeconds": 2
  },
  "Storage": {
    "Provider": "Filesystem",
    "PostgreSql": {
      "ConnectionString": "",
      "MigrationConnectionString": "",
      "Schema": "flowzer",
      "ApplyMigrationsOnStartup": false
    }
  },
  "Authentication": {
    "Scheme": "None",
    "JwtBearer": {
      "Authority": "",
      "Audience": "",
      "RequireHttpsMetadata": true
    }
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Observability": {
    "Enabled": false,
    "UseConsoleExporter": false,
    "OtlpEndpoint": "",
    "OtlpHeaders": "",
    "OtlpProtocol": "grpc",
    "ServiceName": "Flowzer.WebApi"
  }
}
