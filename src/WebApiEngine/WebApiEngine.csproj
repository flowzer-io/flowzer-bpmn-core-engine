<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.11" />
        <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.11" />
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
        <!-- Versand des E-Mail-Konnektors. Bewusst nicht System.Net.Mail.SmtpClient: der ist
             als veraltet gekennzeichnet und fuer einen unbeaufsichtigten Dienst zu schwach. -->
        <PackageReference Include="MailKit" Version="4.18.0" />
        <PackageReference Include="OpenTelemetry.Exporter.Console" Version="1.18.0" />
        <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.18.0" />
        <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.18.0" />
        <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.18.0" />
        <!--
          Den Prometheus-Exporter gibt es bei OpenTelemetry .NET bis heute ausschliesslich als
          Vorabpaket; eine stabile Fassung ist nicht erschienen. 1.18.0-beta.1 stammt aus
          derselben Freigabe wie die uebrigen OpenTelemetry-Pakete hier und verlangt
          OpenTelemetry [1.18.0, 2.0.0) — es passt also exakt auf den vorhandenen Stand.
        -->
        <PackageReference Include="OpenTelemetry.Exporter.Prometheus.AspNetCore" Version="1.18.0-beta.1" />
        <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\Model\Model.csproj" />
      <ProjectReference Include="..\core-engine\core-engine.csproj" />
      <ProjectReference Include="..\FilesystemStorageSystem\FilesystemStorageSystem.csproj" />
      <ProjectReference Include="..\PostgreSqlStorageSystem\PostgreSqlStorageSystem.csproj" />
      <ProjectReference Include="..\StorageSystemShared\StorageSystemShared.csproj" />
      <ProjectReference Include="..\WebApiEngine.Shared\WebApiEngine.Shared.csproj" />
    </ItemGroup>

    <ItemGroup>
      <InternalsVisibleTo Include="WebApiEngine.Tests" />
    </ItemGroup>

    <ItemGroup>
      <_ContentIncludedByDefault Remove="Definitions\32158b42-f502-4a59-845f-3eccd2e64758.json" />
    </ItemGroup>

</Project>
