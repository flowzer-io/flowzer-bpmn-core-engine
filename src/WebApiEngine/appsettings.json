{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "TimerScheduler": {
    "Enabled": true,
    "PollIntervalSeconds": 5
  },
  "IdentityDirectory": {
    "Enabled": false,
    "ServerUrl": "",
    "Issuer": "",
    "Realm": "",
    "ClientId": "",
    "PageSize": 100,
    "MaxPages": 10000,
    "MaxRetries": 2,
    "RetryDelayMilliseconds": 250,
    "RequestTimeoutSeconds": 30,
    "SynchronizationTimeoutSeconds": 300,
    "LeaseGraceSeconds": 30,
    "MaxResponseBytes": 4194304,
    "TokenRefreshSkewSeconds": 15,
    "SyncIntervalSeconds": 300
  },
  "Storage": {
    "Provider": "Filesystem",
    "PostgreSql": {
      "ConnectionString": "",
      "MigrationConnectionString": "",
      "Schema": "flowzer",
      "ApplyMigrationsOnStartup": false
    }
  },
  "Authentication": {
    "Scheme": "None",
    "JwtBearer": {
      "Authority": "",
      "Audience": "",
      "RequireHttpsMetadata": true,
      "RequiredRole": "",
      "Roles": {
        "Modeler": "",
        "Operator": "",
        "Worker": ""
      }
    },
    "Bff": {
      "ClientId": "",
      "ClientSecret": "",
      "Scopes": [],
      "DataProtectionKeysPath": ""
    }
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "ForwardedHeaders": {
    "KnownNetworks": [],
    "KnownProxies": []
  },
  "ServiceTaskWebhooks": {
    "Enabled": true,
    "AllowedHosts": [],
    "AllowHttp": false,
    "TimeoutSeconds": 10,
    "PollIntervalSeconds": 5,
    "MaxConsecutiveFailures": 10
  },
  "RateLimiting": {
    "Enabled": true,
    "PermitLimit": 300,
    "WindowSeconds": 60,
    "QueueLimit": 0
  },
  "Limits": {
    "MaxUploadBytes": 8388608
  },
  "Observability": {
    "Enabled": false,
    "UseConsoleExporter": false,
    "OtlpEndpoint": "",
    "OtlpHeaders": "",
    "OtlpProtocol": "grpc",
    "ServiceName": "Flowzer.WebApi"
  },
  "AllowedHosts": "*"
}
