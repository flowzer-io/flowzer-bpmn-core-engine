{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "TimerScheduler": {
    "Enabled": true,
    "PollIntervalSeconds": 5
  },
  "Storage": {
    "Provider": "Filesystem",
    "PostgreSql": {
      "ConnectionString": "",
      "MigrationConnectionString": "",
      "Schema": "flowzer",
      "ApplyMigrationsOnStartup": false
    }
  },
  "Authentication": {
    "Scheme": "None",
    "JwtBearer": {
      "Authority": "",
      "Audience": "",
      "RequireHttpsMetadata": true,
      "RequiredRole": ""
    }
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "RateLimiting": {
    "Enabled": true,
    "PermitLimit": 300,
    "WindowSeconds": 60,
    "QueueLimit": 0
  },
  "Limits": {
    "MaxUploadBytes": 8388608
  },
  "Observability": {
    "Enabled": false,
    "UseConsoleExporter": false,
    "OtlpEndpoint": "",
    "OtlpHeaders": "",
    "OtlpProtocol": "grpc",
    "ServiceName": "Flowzer.WebApi"
  },
  "AllowedHosts": "*"
}
