# Nur für den isolierten Abnahme-Stack. Offensichtliche Testwerte, die zum synthetischen
# Realm keycloak/flowzer-test-realm.json passen. Niemals in einer echten Installation verwenden.
# Diese Datei wird ausschließlich dem Dienst `api` übergeben.
Storage__PostgreSql__ConnectionString=Host=db;Port=5432;Database=flowzer;Username=flowzer_runtime;Password=flowzer-test-runtime-password
Authentication__Bff__ClientSecret=flowzer-bff-test-secret-not-for-production
IdentityDirectory__ClientSecret=flowzer-directory-test-secret-not-for-production
