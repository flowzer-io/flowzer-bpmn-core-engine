FROM node:22-alpine AS build
WORKDIR /src

# Abhaengigkeiten zuerst: Sie aendern sich seltener als der Quellcode und bleiben
# damit als Zwischenschicht erhalten.
COPY src/FlowzerConsole/package.json src/FlowzerConsole/package-lock.json ./
RUN npm ci

COPY src/FlowzerConsole/ ./
RUN npm run build

FROM nginx:1.27-alpine AS runtime

COPY deploy/console/entrypoint.sh /entrypoint.sh
COPY --from=build /src/dist /usr/share/nginx/html
RUN chmod +x /entrypoint.sh

# Nur nicht geheime Bereitstellungswerte stehen erst zur Laufzeit fest; das Bundle
# soll nicht je Umgebung neu gebaut werden. OIDC-Clientdaten und Tokens bleiben im BFF.
# Siehe entrypoint.sh.
ENV FLOWZER_API_BASE_URL=/ FLOWZER_ACCENT=iris FLOWZER_BFF_ENABLED=true FLOWZER_API_UPSTREAM=

EXPOSE 8080
CMD ["/entrypoint.sh"]
