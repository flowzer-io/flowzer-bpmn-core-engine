# Laufzeit-Stack (compose.runtime.yml): nach .env kopieren und Werte eintragen.
# .env ist lokal und darf nie eingecheckt werden. Secrets gehoeren auch dort nicht hinein;
# den BFF-Clientschluessel ausschliesslich zur Container-Laufzeit aus dem vorgesehenen
# Secret-Store in die Prozessumgebung injizieren.

# Host-Port des Gateways
FLOWZER_RUNTIME_BIND_ADDRESS=127.0.0.1
FLOWZER_RUNTIME_PORT=5288

# Web-API: Der Produktionspfad ist der serverseitige BFF. None und JwtBearer bleiben
# nur fuer lokale bzw. externe kompatible Einsatzfaelle moeglich (siehe OPERATIONS.md).
FLOWZER_AUTH_SCHEME=Bff
# Nur zusammen mit FLOWZER_AUTH_SCHEME=None fuer reine lokale HTTP-Pruefungen auf false setzen.
FLOWZER_BFF_ENABLED=true
FLOWZER_AUTH_AUTHORITY=https://login.microsoftonline.com/<tenant-id>/v2.0
FLOWZER_AUTH_AUDIENCE=api://<api-client-id>
FLOWZER_AUTH_REQUIRE_HTTPS_METADATA=true
# Auch ohne individuelle Konfiguration gelten feste, getrennt zuzuordnende Rollen.
FLOWZER_AUTH_REQUIRED_ROLE=flowzer-access
FLOWZER_AUTH_ROLE_MODELER=flowzer-modeler
FLOWZER_AUTH_ROLE_WORKER=flowzer-worker
# Betriebsrolle für Diagnose und Verzeichnisadministration. Compose verwendet bei
# fehlendem oder leerem Wert den sicheren Rollennamen statt rollenloser Freigabe.
FLOWZER_AUTH_ROLE_OPERATOR=flowzer-operator
# Neue KI-Verbindungsrechte sind im authentifizierten Betrieb fail-closed. Verwendende
# duerfen sichere Metadaten auswaehlen; nur Verwaltende duerfen Ziel und Secret-Referenz aendern.
FLOWZER_AUTH_ROLE_AI_CONNECTION_USER=flowzer-ai-connection-user
FLOWZER_AUTH_ROLE_AI_CONNECTION_MANAGER=flowzer-ai-connection-manager
# Nur fuer Bestandsinstallationen mit bewusst leerer Zugangs-, Modeler-, Operator- oder
# Worker-Rolle auf true setzen; jede angemeldete Person erhaelt dann die jeweilige Faehigkeit.
# Ohne den Schalter startet die API nicht, solange einer dieser Rollennamen leer ist.
FLOWZER_AUTH_LEGACY_PERMISSIVE_ROLES=false

# KI-Datenflussgrenzen sind installationsweite Opt-ins. Beide Defaults bleiben false.
FLOWZER_AI_ALLOW_CLOUD_PROVIDERS=false
FLOWZER_AI_ALLOW_LOCAL_ENDPOINTS=false
# Separates Opt-in für tatsächliche Provideraufrufe; nur nach Installationsabnahme aktivieren.
FLOWZER_AI_EXECUTION_ENABLED=false
# Beispielreferenz in der Console: env:FLOWZER_AI_PRIMARY. Den Wert ausschliesslich
# zur Container-Laufzeit aus dem Secret-Store injizieren, niemals in .env eintragen.
# FLOWZER_AI_PRIMARY wird zur Laufzeit injiziert; hier absichtlich kein Wert.

# Mitgelieferte Konnektoren (eingebaute Worker im API-Prozess, siehe docs/CONNECTORS.md).
# Beide sind aus. Der HTTP-Konnektor ruft ohne Freigabeliste nichts auf, der E-Mail-
# Konnektor versendet ohne freigegebene Empfaengerdomaene nichts — so mailt ein Testsystem
# nicht versehentlich nach aussen.
FLOWZER_CONNECTOR_HTTP_ENABLED=false
FLOWZER_CONNECTOR_HTTP_ALLOWED_HOSTS=
FLOWZER_CONNECTOR_EMAIL_ENABLED=false
FLOWZER_CONNECTOR_EMAIL_FROM=
FLOWZER_CONNECTOR_EMAIL_ALLOWED_DOMAINS=
FLOWZER_CONNECTOR_SMTP_HOST=
FLOWZER_CONNECTOR_SMTP_PORT=587
FLOWZER_CONNECTOR_SMTP_USE_STARTTLS=true
FLOWZER_CONNECTOR_SMTP_USERNAME=
# Nur der Name des Secrets, nicht der Wert. Das Passwort steht dann in
# FLOWZER_CONNECTOR_SECRET_<Name> und wird ausschliesslich zur Container-Laufzeit aus dem
# Secret-Store injiziert; hier absichtlich kein Wert.
FLOWZER_CONNECTOR_SMTP_PASSWORD_SECRET=
# Eingehende Ausloeser (docs/INBOUND-TRIGGERS.md). Unter diesem installationsweiten
# Schluessel liegen die Geheimnisse der Ausloeser versiegelt in der Ablage. Ohne ihn
# nimmt die Installation keinen Ausloeser an; mindestens 32 Zeichen. Er ist ein echtes
# Secret und wird zur Laufzeit aus dem Secret-Store injiziert, niemals hier eingetragen.
# Geht er verloren, brauchen alle Ausloeser ein neues Geheimnis.
# FLOWZER_INBOUND_TRIGGER_SECRET_KEY wird zur Laufzeit injiziert; hier absichtlich kein Wert.

# Vertraulicher OIDC-Client des BFF. Die Redirect-URI lautet
# https://<flowzer-host>/bff/signin-oidc. FLOWZER_BFF_CLIENT_SECRET ist ein echtes
# Secret und wird beim Start aus dem Secret-Store injiziert. Es steht nie in .env,
# config.json, dem Konsolen-Container oder dem Browser.
FLOWZER_BFF_CLIENT_ID=<confidential-bff-client-id>
# FLOWZER_BFF_CLIENT_SECRET wird zur Laufzeit injiziert; hier absichtlich kein Wert.
# Zusaetzliche Scopes neben openid, profile und email. Fuer Entra typischerweise der
# API-Scope; Keycloak kann bei einem Audience-Mapper leer bleiben. Weitere Scopes sind
# bei Bedarf als FLOWZER_BFF_SCOPE_1 und FLOWZER_BFF_SCOPE_2 moeglich.
FLOWZER_BFF_SCOPE_0=api://<api-client-id>/access_as_user
FLOWZER_BFF_SCOPE_1=
FLOWZER_BFF_SCOPE_2=
# Abmeldung auch beim Identity Provider (RP-initiated Logout). Ohne Schalter beendet die
# Abmeldung nur die Flowzer-Sitzung, die SSO-Sitzung bleibt bestehen. Erst einschalten, wenn
# der BFF-Client beim Identity Provider https://<flowzer-host> plus
# FLOWZER_BFF_POST_LOGOUT_PATH als Post-Logout-Redirect-URI erlaubt; sonst endet die
# Abmeldung auf einer Fehlerseite des Providers. Der Pfad muss lokal und absolut sein.
FLOWZER_BFF_PROVIDER_LOGOUT=false
FLOWZER_BFF_POST_LOGOUT_PATH=/

# Optionaler lesender Keycloak-Verzeichnisabgleich. ServerUrl ist die technische Admin-
# Basisadresse; Issuer muss exakt dem `iss`-Claim der Benutzer-Tokens entsprechen. Das
# Servicekonto braucht nur Leserechte fuer Benutzer, Gruppen und Mitgliedschaften.
FLOWZER_DIRECTORY_ENABLED=false
FLOWZER_DIRECTORY_SERVER_URL=https://keycloak.example.invalid
FLOWZER_DIRECTORY_ISSUER=https://keycloak.example.invalid/realms/flowzer
FLOWZER_DIRECTORY_REALM=flowzer
FLOWZER_DIRECTORY_CLIENT_ID=flowzer-directory-sync
FLOWZER_DIRECTORY_SYNC_INTERVAL_SECONDS=300
# FLOWZER_DIRECTORY_CLIENT_SECRET wird ausschliesslich zur Laufzeit aus dem Secret-Store
# injiziert; hier absichtlich kein Wert.
# CIDR des privaten Container-Netzes, aus dem die API Forwarded-Header akzeptiert.
# Fuer abweichende Docker-Adressbereiche installationsspezifisch setzen.
FLOWZER_TRUSTED_PROXY_NETWORK=172.16.0.0/12
# TLS-Proxy, Runtime-Gateway und Konsolen-nginx ergeben hoechstens drei Stufen.
FLOWZER_FORWARDED_HEADER_LIMIT=3

# Aufbewahrung beendeter Instanzen. Ohne Wert oder mit 0 ist sie aus: Beendete Instanzen
# bleiben dann dauerhaft erhalten. Mit einer Frist werden beendete Instanzen (abgeschlossen,
# abgebrochen und fehlgeschlagen) samt Verlauf, Aufgabendaten, Auftraegen und Ereignisspur
# endgueltig geloescht; laufende Instanzen nie. Einzelne Workflows koennen die Frist ueber
# ihr Katalogmetadatum retentionDays ueberschreiben (0 dort heisst "nie loeschen").
# Achtung: Ein Backup, das aelter ist als die Frist, enthaelt die geloeschten Vorgaenge
# weiterhin. Siehe OPERATIONS.md, Abschnitt Aufbewahrung.
FLOWZER_RETENTION_DAYS=
FLOWZER_RETENTION_POLL_INTERVAL_MINUTES=60
FLOWZER_RETENTION_BATCH_SIZE=100

# Prometheus-Scrape-Endpunkt der Web-API. Standardmaessig aus. Er antwortet ohne Anmeldung,
# weil Prometheus keine Sitzung mitbringt, und gibt die Innenansicht der Installation preis.
# Deshalb gilt: nur im Containernetz unter api:8080 abholen. Das Konsolen-Gateway leitet den
# Pfad bewusst nicht weiter; tests/ui-smoke/check-gateway-routes.sh prueft das.
FLOWZER_METRICS_ENABLED=false
FLOWZER_METRICS_PATH=/metrics

# Akzentfarbe der Oberflaeche, damit sie zum Erscheinungsbild des Unternehmens passt:
# iris, teal, emerald, amber oder rose. Gilt fuer alle; es gibt keine persoenliche
# Einstellung dafuer.
FLOWZER_ACCENT=iris
