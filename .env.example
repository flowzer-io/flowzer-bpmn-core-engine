# Laufzeit-Stack (compose.runtime.yml): nach .env kopieren und Werte eintragen.

# Host-Port des Gateways
FLOWZER_RUNTIME_PORT=5288

# Web-API: OIDC-Token-Pruefung (None = ohne Anmeldung, nur fuer lokale Pruefungen)
FLOWZER_AUTH_SCHEME=JwtBearer
FLOWZER_AUTH_AUTHORITY=https://login.microsoftonline.com/<tenant-id>/v2.0
FLOWZER_AUTH_AUDIENCE=api://<api-client-id>
FLOWZER_AUTH_REQUIRE_HTTPS_METADATA=true

# Oberflaeche: OIDC-Anmeldung (Public Client mit PKCE). Bei JwtBearer zwingend setzen,
# sonst zeigt die Oberflaeche einen technischen Benutzer und die API antwortet 401.
# Scopes leerzeichengetrennt, zusaetzlich zu openid profile.
FLOWZER_OIDC_AUTHORITY=https://login.microsoftonline.com/<tenant-id>/v2.0
FLOWZER_OIDC_CLIENT_ID=<spa-client-id>
FLOWZER_OIDC_SCOPES=api://<api-client-id>/access_as_user offline_access

# Keycloak-Variante: FLOWZER_AUTH_AUDIENCE=flowzer-api (Audience-Mapper im Realm),
# FLOWZER_OIDC_SCOPES=offline_access
